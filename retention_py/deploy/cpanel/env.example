# Copy to <app root>/.env and fill in. Never commit the real file.
APP_ENV=production
APP_URL=https://safedata.3consult-ng.com
ALLOWED_HOSTS=safedata.3consult-ng.com

# python -c "import secrets; print(secrets.token_urlsafe(64))"
SECRET_KEY=
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
BACKUP_ENCRYPTION_KEY=

# cPanel -> PostgreSQL Databases (database + user, user added with ALL privileges)
DATABASE_URL=postgresql+psycopg2://CPANELUSER_sdapp:DB_PASSWORD@localhost:5432/CPANELUSER_safedata

# cPanel has a persistent disk, so attachments/backups can stay on it (outside public_html)
STORAGE_BACKEND=local
STORAGE_LOCAL_PERSISTENT=1
STORAGE_LOCAL_ROOT=/home/CPANELUSER/safedata_storage

# cPanel -> Email Accounts -> noreply@3consult-ng.com -> Connect Devices
SMTP_HOST=mail.3consult-ng.com
SMTP_PORT=465
SMTP_SECURE=ssl
SMTP_USER=noreply@3consult-ng.com
SMTP_PASS=
SMTP_FROM_EMAIL=noreply@3consult-ng.com
MAIL_DOMAIN=3consult-ng.com

# Run Alembic migrations automatically when the app (re)starts
SAFEDATA_AUTO_MIGRATE=1
