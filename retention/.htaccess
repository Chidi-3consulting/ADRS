RewriteEngine On
RewriteBase /retention/

# Enterprise REST API — route /api/v1/* to the API router (own key-auth layer)
RewriteRule ^api/v1/(.*)$ src/api/v1/router.php?_route=$1 [QSA,L]

# Route remaining non-file requests to the front controller
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# Protect config and source files
<FilesMatch "^(config|includes|engine|sql|\.htaccess|composer\.json)$">
  Require all denied
</FilesMatch>
