RewriteEngine On
RewriteBase /retention/

# Route non-file requests to index.php
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^ index.php [L,QSA]

# Protect config and source files
<FilesMatch "^(config|includes|engine|sql|\.htaccess|composer\.json)$">
  Require all denied
</FilesMatch>
